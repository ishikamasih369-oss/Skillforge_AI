# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillforge_ai

# JWT Authentication
SECRET_KEY=your_secure_jwt_secret_key_here

# Ollama Local AI Configuration (Free & Open Source, No API Key Required)
# 1. Download and install Ollama from https://ollama.com
# 2. Pull the chosen model in your terminal:
#    ollama pull gemma3:4b
# 3. Ensure Ollama is running (defaults to http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Local inference timeout in seconds (default is 180s)
OLLAMA_TIMEOUT_SECONDS=180

